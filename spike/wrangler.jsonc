{
	"name": "junco-prm-spike",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// The id is filled in by `wrangler d1 create junco-prm-spike`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "junco-prm-spike",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	// QUESTION 3 IS ANSWERED BY WHETHER THIS BLOCK IS ACCEPTED AT DEPLOY.
	// If `wrangler deploy` refuses it on a free account, delete this block,
	// deploy again, and record RATE_LIMIT_STRATEGY = "kv_token_bucket".
	"ratelimits": [
		{
			"name": "SPIKE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		}
	],
	// Required: the CPU measurement is read from `wrangler tail`, not from
	// anything the Worker can measure about itself. See src/index.ts.
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "667f8106023c43928da89168e9c61209"
		}
	]
}