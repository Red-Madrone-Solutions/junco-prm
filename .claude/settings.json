{
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push --no-verify*)",
      "Bash(git -c core.hooksPath=*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/deny-verify-bypass.mjs\"",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "Checking for a hook bypass"
          }
        ]
      }
    ]
  }
}
